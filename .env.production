# ═══════════════════════════════════════════════════════════════════════════
# CHIMERA — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# Usage:
#   cp .env.production .env
#   # Edit .env with your API keys (minimum: one LLM provider key)
#   docker compose up -d --build
#
# Sections:
#   1. App Core
#   2. Database (Prisma/SQLite)
#   3. 9router — Primary LLM Provider
#   4. 9router — Secondary Providers (pick any)
#   5. 9router — Extended Providers (optional)
#   6. Azure / Vertex / Cloudflare
#   7. ZAI SDK Fallback
#   8. Bitcoin Vault Security
#   9. Obscura Browser
#  10. Colibri Inference Engine
#  11. Ollama Local LLM
#  12. CodeGeeX4 Native
#  13. Docker / Network
#  14. Caddy / SSL
#
# ═══════════════════════════════════════════════════════════════════════════


# ─── 1. APP CORE ──────────────────────────────────────────────────────────

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
APP_PORT=3000
HOSTNAME=0.0.0.0


# ─── 2. DATABASE (Prisma + SQLite) ────────────────────────────────────────

DATABASE_URL="file:/app/data/chimera.db"


# ─── 3. 9ROUTER — PRIMARY LLM PROVIDER ────────────────────────────────────
# At least ONE of these is REQUIRED for CHIMERA to function.

# GLM / Zhipu AI (primary — used by Colibri + default chat)
ZAI_API_KEY=
ZHIPU_API_KEY=
GLM_API_KEY=


# ─── 4. 9ROUTER — SECONDARY PROVIDERS ─────────────────────────────────────
# Fill in the ones you have. CHIMERA auto-detects which are configured.

# OpenAI (GPT-4o, o3, o4-mini)
OPENAI_API_KEY=

# Anthropic / Claude (Claude 4 Sonnet, Claude 4 Opus, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# Google Gemini (Gemini 2.5 Pro, Gemini 2.5 Flash)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# DeepSeek (DeepSeek-V3, DeepSeek-Reasoner)
DEEPSEEK_API_KEY=

# Groq (Llama 4 Maverick/Scout — 32ms inference)
GROQ_API_KEY=

# xAI / Grok (Grok 3, Grok 3 Mini)
XAI_API_KEY=
GROK_API_KEY=

# Mistral (Mistral Large, Codestral)
MISTRAL_API_KEY=

# OpenRouter (100+ models meta-router)
OPENROUTER_API_KEY=

# Perplexity (Sonar Pro — web-connected)
PERPLEXITY_API_KEY=

# Together AI (Llama 4, Mixtral)
TOGETHER_API_KEY=

# Fireworks AI (Llama 4 Scout)
FIREWORKS_API_KEY=

# Cerebras (Wafer-scale inference, 32ms latency)
CEREBRAS_API_KEY=

# SiliconFlow (DeepSeek-V3, Qwen3-8B)
SILICONFLOW_API_KEY=

# Cohere (Command R+, Command A)
COHERE_API_KEY=

# NVIDIA NIM (Llama 4 NIM-optimized)
NVIDIA_API_KEY=

# Hyperbolic (DeepSeek-V3)
HYPERBOLIC_API_KEY=

# SambaNova (Llama 4, reconfigurable hardware)
SAMBANOVA_API_KEY=


# ─── 5. 9ROUTER — EXTENDED PROVIDERS (optional) ───────────────────────────

# Azure OpenAI (enterprise GPT-4o)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Google Vertex AI (Gemini enterprise)
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudflare Workers AI (Llama 3.1)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=


# ─── 6. ZAI SDK FALLBACK ─────────────────────────────────────────────────
# Used as last resort when all 9router providers fail.
# Set automatically by the ZAI platform — no manual config needed.


# ─── 7. BITCOIN VAULT SECURITY ───────────────────────────────────────────
# AES-256-GCM encryption key for vault custody operations.
# REQUIRED for Bitcoin vault features. Generate with: openssl rand -hex 32

VAULT_ENCRYPTION_KEY=


# ─── 8. OBSCURA BROWSER ──────────────────────────────────────────────────
# Headless Rust/V8 browser integration.
# Enable in docker compose: docker compose --profile obscura up -d

ENABLE_OBSCURA=false
OBSCURA_CDP_HOST=obscura
OBSCURA_CDP_PORT=9222
OBSCURA_SERVE_PORT=9223
OBSCURA_HEADLESS=true
OBSCURA_STEALTH=true


# ─── 9. COLIBRI INFERENCE ENGINE ─────────────────────────────────────────
# GLM-5.2 744B MoE expert routing engine.
# Enable in docker compose: docker compose --profile colibri up -d

ENABLE_COLIBRI=false
COLIBRI_HOST=colibri
COLIBRI_PORT=8000
COLIBRI_MODEL=glm-5.2-744b-moe


# ─── 10. OLLAMA LOCAL LLM ────────────────────────────────────────────────
# Local LLM inference (Llama 3, Mistral, Phi-3, etc.)
# Enable in docker compose: docker compose --profile ollama up -d

ENABLE_OLLAMA=false
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=llama3


# ─── 11. CODEGEEX4 NATIVE (OpenAI-Compatible API) ───────────────────────────
# CodeGeeX4 9B code-specialist model with /v1/chat/completions endpoint.
# Exposes streaming + function calling + 128K context window.
# Enable in docker compose: docker compose --profile codegeex up -d
# Requires: GPU (NVIDIA CUDA) + model weights in codegeex4-models volume.

ENABLE_CODEGEEX=false
CODEGEEX_HOST=codegeex
CODEGEEX_PORT=8001
CODEGEEX_MODEL=codegeex4
CODEGEEX_MAX_TOKENS=4096
CODEGEEX_TEMPERATURE=0.2


# ─── 12. DOCKER / NETWORK ────────────────────────────────────────────────

CADDY_ADMIN_PORT=2019


# ─── 13. CADDY / SSL ─────────────────────────────────────────────────────
# Set to your domain for automatic Let's Encrypt SSL.
# Leave empty for HTTP-only (port 80).

PUBLIC_DOMAIN=
