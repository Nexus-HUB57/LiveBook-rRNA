# =================================================================
# CHIMERA Multi-Agent Fusion Engine — Produção
# .env.production
# =================================================================
# Uso:
#   cp .env.production .env
#   docker compose up -d --build
# =================================================================


# =================================================================
# S1 — BANCO DE DADOS (Prisma 6 + SQLite)
# =================================================================
# Caminho Docker montado no volume 'chimera-db' -> /app/db

DATABASE_URL=file:/app/db/chimera.db


# =================================================================
# S2 — CONFIGURAÇÃO DA APLICAÇÃO
# =================================================================
# Next.js 16 standalone — escuta internamente na porta 3000

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
APP_PORT=3000


# =================================================================
# S3 — PROVEDORES LLM — 9ROUTER BRIDGE (20+ provedores)
# =================================================================
# Ordem de prioridade: GLM/ZAI (primário), depois os demais.
# Cada provedor aceita um ou mais nomes de variável (fallback).
# Preencha SOMENTE as chaves que você possui; deixe vazio = desativado.

# -- 3.1  GLM / ZAI — Provedor Primário ---------------------------
ZAI_API_KEY=
GLM_API_KEY=
ZHIPU_API_KEY=

# -- 3.2  OpenAI --------------------------------------------------
OPENAI_API_KEY=

# -- 3.3  Anthropic / Claude --------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=

# -- 3.4  Google / Gemini -----------------------------------------
GOOGLE_API_KEY=
GEMINI_API_KEY=

# -- 3.5  DeepSeek ------------------------------------------------
DEEPSEEK_API_KEY=

# -- 3.6  Groq ----------------------------------------------------
GROQ_API_KEY=

# -- 3.7  xAI / Grok ----------------------------------------------
XAI_API_KEY=
GROK_API_KEY=

# -- 3.8  Mistral -------------------------------------------------
MISTRAL_API_KEY=

# -- 3.9  Together AI ---------------------------------------------
TOGETHER_API_KEY=

# -- 3.10 Fireworks AI --------------------------------------------
FIREWORKS_API_KEY=

# -- 3.11 OpenRouter ----------------------------------------------
OPENROUTER_API_KEY=

# -- 3.12 Cerebras ------------------------------------------------
CEREBRAS_API_KEY=

# -- 3.13 SiliconFlow ---------------------------------------------
SILICONFLOW_API_KEY=

# -- 3.14 Ollama (local — sem chave, configuração de URL) ---------
# Ollama roda localmente; nenhuma API key necessária.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -- 3.15 Azure OpenAI --------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# -- 3.16 Cohere -------------------------------------------------
COHERE_API_KEY=

# -- 3.17 NVIDIA NIM ----------------------------------------------
NVIDIA_API_KEY=

# -- 3.18 Hyperbolic ----------------------------------------------
HYPERBOLIC_API_KEY=

# -- 3.19 SambaNova -----------------------------------------------
SAMBANOVA_API_KEY=

# -- 3.20 Cloudflare Workers AI -----------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# -- 3.21 Binance (preços BTC + API trading) ----------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# -- 3.22 Perplexity (bônus) -------------------------------------------
PERPLEXITY_API_KEY=


# =================================================================
# S4 — CIFRA DO COFRE (Bitcoin Vault — AES-256-GCM)
# =================================================================
# OBRIGATÓRIO — Sem esta variável, o VaultService falha.
# Gere com: openssl rand -hex 32
# A chave é derivada via scrypt (salt: "nexus-salt") para 256 bits.

VAULT_ENCRYPTION_KEY=


# =================================================================
# S5 — MOTOR COLIBRI (GLM-5.2 744B MoE)
# =================================================================
# Endpoint do servidor Colibri (backend C/inferência local).
# Dentro do container Docker, use o nome do serviço ou 127.0.0.1.

COLIBRI_URL=http://127.0.0.1:8000
COLIBRI_MODEL=glm-5.2-744b-moe
COLIBRI_MAX_TOKENS=8192
COLIBRI_TEMPERATURE=0.7
COLIBRI_TOP_P=0.9


# =================================================================
# S6 — SANDBOX (Node.js VM — Execução Isolada)
# =================================================================
# Limites de recursos para execuções no sandbox.

SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MAX_MEMORY_MB=128
SANDBOX_MAX_EXECUTIONS_PER_AGENT=50
SANDBOX_EVOLUTION_ENABLED=true


# =================================================================
# S7 — OBSCURA (Navegador Headless — CDP)
# =================================================================
# Binário do Obscura e porta CDP para scraping/automação.

OBSCURA_BINARY=/app/bin/obscura/obscura
OBSCURA_PORT=9223
OBSCURA_WORKERS=4
OBSCURA_STEALTH=true
OBSCURA_DEFAULT_TIMEOUT=30


# =================================================================
# S8 — CADDY / DOMÍNIO / REVERSE PROXY
# =================================================================
# Descomente e preencha para ativar SSL automático (Let's Encrypt).
# Sem domínio, Caddy serve HTTP puro na porta 80.

# PUBLIC_DOMAIN=chimera.seudominio.com
# CADDY_ADMIN_ADDR=0.0.0.0:2019


# =================================================================
# S9 — CABEÇALHOS DE SEGURANÇA
# =================================================================
# Refletidos pelo Caddy e/ou middleware Next.js.

SEC_HEADER_X_CONTENT_TYPE_OPTIONS=nosniff
SEC_HEADER_X_FRAME_OPTIONS=DENY
SEC_HEADER_X_XSS_PROTECTION=1; mode=block
SEC_HEADER_REFERRER_POLICY=strict-origin-when-cross-origin
SEC_HEADER_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()
SEC_HEADER_HSTS=max-age=31536000; includeSubDomains; preload
SEC_HEADER_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https: http://127.0.0.1:*; frame-ancestors 'none'


# =================================================================
# S10 — AUTENTICAÇÃO & SEGREDO
# =================================================================
# Gere com: openssl rand -hex 48

JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000


# =================================================================
# S11 — OBSERVABILIDADE & LOGS
# =================================================================

ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
LOG_LEVEL=warn
